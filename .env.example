# Copy to .env and fill in. Never commit, upload or share .env.
ANTHROPIC_API_KEY=
# Optional: a strong random token is generated and saved in data/.agent_token if omitted.
# REQUIRED (32+ characters) when running through agent_app.wsgi on a host such as Render.
# AGENT_TOKEN=
# Default model (checked 2026-10-28). claude-sonnet-5 also exists but is marked legacy by Anthropic.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AGENT_HOST=127.0.0.1
# AGENT_PORT=8080
# AGENT_MAX_STEPS=12
# Sonnet 5.5 thinking counts toward this limit.
# AGENT_MAX_TOKENS=8000
# Set to 0 on any public/shared host (disables the run_python tool)
# AGENT_ENABLE_RUN_PYTHON=1
# Set to 1 if your host erases local files on restart (shows a warning in the UI)
# AGENT_EPHEMERAL_STORAGE=0
# Optional: official search API. Brave's API is metered and needs a card, so web_search uses
# DuckDuckGo (free, no key) unless you set this.
# BRAVE_API_KEY=
# How long (seconds, 0-60) the phone_action tool waits for the phone to confirm before reporting "queued"
# AGENT_PHONE_WAIT=20
# Lifetime in days (1-365) of a paired phone's credential. Re-pair after it expires.
# AGENT_DEVICE_TOKEN_DAYS=90
# Set to 1 to show a generic "task finished/failed" notification on paired phones (no task text is included).
# AGENT_NOTIFY_ON_COMPLETE=0
# Set to 1 ONLY when a reverse proxy (Render, nginx...) is in front of the app, so the real client address is used
# for rate limiting. Never set it when the app is directly reachable: the address could then be spoofed.
# AGENT_TRUST_PROXY=0
# The production entry point (agent_app.wsgi) keeps run_python OFF even if AGENT_ENABLE_RUN_PYTHON=1.
# Set this to 1 only if you fully accept that risk.
# AGENT_ALLOW_RUN_PYTHON_IN_PRODUCTION=0
