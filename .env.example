# Gemini API key from Google AI Studio. Keep it private; never commit or share .env.
GEMINI_API_KEY=
# Gemini model and API endpoint
GEMINI_MODEL=gemini-2.5-flash
# Optional: a strong random token is generated and saved in data/.agent_token if omitted.
# AGENT_TOKEN=
# Daily model-call runtime limit: 10 minutes total; resets midnight Pakistan time.
AGENT_DAILY_AI_SECONDS=600
# The first run starts the persistent 30-day trial. No paid billing is enabled by this app.
AGENT_TRIAL_DAYS=30
AGENT_HOST=127.0.0.1
AGENT_PORT=8080
AGENT_MAX_STEPS=12
AGENT_MAX_TOKENS=4096
AGENT_ENABLE_RUN_PYTHON=1
AGENT_EPHEMERAL_STORAGE=0
# Optional web search API; Brave is metered. Leave blank for DuckDuckGo.
BRAVE_API_KEY=
AGENT_PHONE_WAIT=20
AGENT_DEVICE_TOKEN_DAYS=90
AGENT_NOTIFY_ON_COMPLETE=0
AGENT_TRUST_PROXY=0
AGENT_ALLOW_RUN_PYTHON_IN_PRODUCTION=0
